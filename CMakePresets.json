{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC x64",
      "description": "Run from Developer PowerShell for Visual Studio with JUCE_ROOT set.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/windows-msvc",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "EHVOTA_BUILD_UI_PREVIEW": "ON",
        "EHVOTA_BUILD_TESTS": "ON",
        "EHVOTA_JUCE_SOURCE_DIR": "$env{JUCE_ROOT}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "portable-tests",
      "displayName": "Portable deterministic tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/portable-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "EHVOTA_BUILD_UI_PREVIEW": "OFF",
        "EHVOTA_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },
    {
      "name": "portable-tests",
      "configurePreset": "portable-tests"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "portable-tests",
      "configurePreset": "portable-tests",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
